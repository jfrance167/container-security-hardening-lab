{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {"name": "hardened-demo", "namespace": "lab"},
  "spec": {
    "replicas": 2,
    "selector": {"matchLabels": {"app": "hardened-demo"}},
    "template": {
      "metadata": {"labels": {"app": "hardened-demo"}},
      "spec": {
        "automountServiceAccountToken": false,
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 65532,
          "runAsGroup": 65532,
          "seccompProfile": {"type": "RuntimeDefault"}
        },
        "containers": [
          {
            "name": "app",
            "image": "example.invalid/security-lab@sha256:abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789",
            "securityContext": {
              "privileged": false,
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {"drop": ["ALL"]}
            },
            "resources": {
              "requests": {"cpu": "50m", "memory": "64Mi"},
              "limits": {"cpu": "250m", "memory": "128Mi"}
            }
          }
        ]
      }
    }
  }
}
