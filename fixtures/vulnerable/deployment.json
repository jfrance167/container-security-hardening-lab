{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {"name": "insecure-demo", "namespace": "lab"},
  "spec": {
    "replicas": 1,
    "selector": {"matchLabels": {"app": "insecure-demo"}},
    "template": {
      "metadata": {"labels": {"app": "insecure-demo"}},
      "spec": {
        "hostNetwork": true,
        "containers": [
          {
            "name": "app",
            "image": "example.invalid/security-lab:latest",
            "securityContext": {
              "privileged": true,
              "allowPrivilegeEscalation": true
            }
          }
        ]
      }
    }
  }
}
